{
  "name": "demli-olsun",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Demli Olsun — dikey mobil çay doldurma oyunu (Capacitor + Vue 3 + Phaser)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json",
    "lint": "eslint .",
    "format": "prettier --write src tests",
    "check": "npm run typecheck && eslint src tests --max-warnings=0 && prettier --check src tests && vitest run && vite build",
    "art": "node tools/art/build.mjs",
    "cap:sync": "npm run build && cap sync",
    "cap:assets": "capacitor-assets generate --assetPath assets"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.2.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@revenuecat/purchases-capacitor": "^13.7.3",
    "mitt": "^3.0.1",
    "phaser": "^4.2.1",
    "pinia": "^4.0.3",
    "vue": "^3.5.43",
    "zzfx": "^1.4.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "prettier": "^3.9.9",
    "typescript": "~5.9",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12"
  }
}
