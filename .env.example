# Bu dosya commit'lenir. Gerçek değerleri .env dosyasına yaz (.env commit'lenmez).
# DİKKAT: VITE_ ile başlayan her değer uygulama paketine gömülür.
# Buraya yalnızca zaten herkese açık kimlikleri koy (AdMob unit ID, RevenueCat public SDK key).

# Mock servisleri zorla (true/false). Tarayıcıda zaten mock kullanılır.
VITE_FORCE_MOCK_ADS=false
VITE_FORCE_MOCK_IAP=false
# mock | real  (gerçek liderlik backend'i bağlanana kadar mock)
VITE_LEADERBOARD_MODE=mock

# Geliştirici menüsü (logoya 5 kez dokun). Geliştirme sunucusunda hep açık; release'te false bırak.
VITE_DEV_MENU=false

# Aktif tema: auto | default | kis | yaz | halloween
VITE_ACTIVE_THEME=auto

# AdMob reklam birimleri — yalnızca release (npm run build / cap:sync) derlemede kullanılır.
# Boş bırakılırsa Google'ın resmi TEST kimlikleri kullanılır. AdMob UYGULAMA kimliği buraya değil,
# android/gradle.properties (ADMOB_APP_ID) ve ios/App/App/Info.plist (GADApplicationIdentifier) içine yazılır.
VITE_ADMOB_REWARDED_ANDROID=
VITE_ADMOB_REWARDED_IOS=
VITE_ADMOB_INTERSTITIAL_ANDROID=
VITE_ADMOB_INTERSTITIAL_IOS=
VITE_ADMOB_BANNER_ANDROID=
VITE_ADMOB_BANNER_IOS=

# RevenueCat public SDK anahtarları
VITE_REVENUECAT_KEY_ANDROID=
VITE_REVENUECAT_KEY_IOS=

# Mağaza ve gizlilik bağlantıları
VITE_STORE_URL=https://example.com/demli-olsun
VITE_PRIVACY_URL=https://example.com/demli-olsun/gizlilik
